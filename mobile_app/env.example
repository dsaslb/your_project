# 모바일 앱 환경 변수 설정
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요

# API 서버 URL
API_URL=http://localhost:5000

# WebSocket 서버 URL  
WS_URL=ws://localhost:5000

# 개발 환경 설정
NODE_ENV=development
DEBUG=true

# 네트워크 설정
NETWORK_TIMEOUT=10000
RECONNECT_DELAY=2000
MAX_RECONNECT_ATTEMPTS=3

# 동기화 설정
BATCH_SIZE=50
SYNC_INTERVAL=30000
MAX_RETRIES=3

# 로깅 설정
LOG_LEVEL=info
ENABLE_CONSOLE_LOG=true
