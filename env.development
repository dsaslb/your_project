# 개발 환경 설정
FLASK_ENV=development
FLASK_DEBUG=true

# 데이터베이스 설정
DEV_DATABASE_URL=sqlite:///dev.db
SQLALCHEMY_TRACK_MODIFICATIONS=true

# 보안 설정 (개발용 - 프로덕션에서는 변경 필요)
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# Redis 설정
REDIS_URL=redis://localhost:6379/0

# CORS 설정
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Rate Limiting (개발용 - 관대한 설정)
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=1000 per day;200 per hour;50 per minute

# 로깅 설정
LOG_LEVEL=DEBUG
LOG_FILE=logs/dev.log

# 이메일 설정 (개발용)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=dev@example.com
MAIL_PASSWORD=dev-password

# 외부 API 키 (개발용)
KAKAO_API_KEY=dev-kakao-api-key
GOOGLE_API_KEY=dev-google-api-key

# 모니터링 설정
ENABLE_METRICS=true
METRICS_PORT=9090

# 플러그인 설정
PLUGIN_AUTO_LOAD=true
PLUGIN_DIR=plugins

# 파일 업로드 설정
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# 세션 설정
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# 캐시 설정
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300 