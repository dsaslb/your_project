# 프로덕션 환경 설정
FLASK_ENV=production
FLASK_DEBUG=false

# 데이터베이스 설정
PRODUCTION_DATABASE_URL=postgresql://user:password@localhost:5432/yourprogram_prod
SQLALCHEMY_TRACK_MODIFICATIONS=false

# 보안 설정 (실제 값으로 변경 필요)
SECRET_KEY=your-super-secret-production-key-change-this
JWT_SECRET_KEY=your-super-secret-jwt-production-key-change-this

# Redis 설정
REDIS_URL=redis://localhost:6379/0

# CORS 설정 (실제 도메인으로 변경 필요)
CORS_ORIGINS=https://yourprogram.com,https://admin.yourprogram.com,https://api.yourprogram.com

# Rate Limiting (프로덕션용 - 엄격한 설정)
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per day;20 per hour;5 per minute

# 로깅 설정
LOG_LEVEL=ERROR
LOG_FILE=logs/production.log

# 이메일 설정 (실제 값으로 변경 필요)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# 외부 API 키 (실제 값으로 변경 필요)
KAKAO_API_KEY=your-kakao-api-key
GOOGLE_API_KEY=your-google-api-key

# 모니터링 설정
ENABLE_METRICS=true
METRICS_PORT=9090

# 플러그인 설정
PLUGIN_AUTO_LOAD=true
PLUGIN_DIR=plugins

# 파일 업로드 설정
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# 세션 설정 (프로덕션용 - 보안 강화)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# 캐시 설정
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=300

# 관리자 이메일 (에러 알림용)
ADMINS=admin@yourprogram.com,dev@yourprogram.com 