# Your Program 개발 환경 설정

# 애플리케이션 설정
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-for-development-only
JWT_SECRET_KEY=dev-jwt-secret-key-for-development-only

# 데이터베이스 설정 (SQLite - PostgreSQL 준비 완료)
DATABASE_URL=sqlite:///C:/your_program/instance/your_program_dev.db
# PostgreSQL 설정 (설치 후 주석 해제)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/your_program_dev
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=your_program_dev
# DB_USER=postgres
# DB_PASSWORD=password

# Redis 설정 (Fallback to Memory Cache)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TYPE=simple
CACHE_FALLBACK=true

# OAuth2 설정 (개발용)
GOOGLE_CLIENT_ID=dev_google_client_id
GOOGLE_CLIENT_SECRET=dev_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

KAKAO_CLIENT_ID=dev_kakao_client_id
KAKAO_CLIENT_SECRET=dev_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/oauth/kakao/callback

# 2FA 설정 (개발용)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=dev@example.com
EMAIL_PASSWORD=dev_password
EMAIL_USE_TLS=true

SMS_API_KEY=dev_sms_api_key
SMS_SECRET_KEY=dev_sms_secret_key
SMS_FROM_NUMBER=dev_sms_number

# 보안 설정 (개발용) - 가상 서버 지원 추가
CORS_ORIGINS=http://localhost:3000,http://192.168.45.44:3000,http://localhost:5000,*
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=1000 per day;200 per hour;50 per minute
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true

# 로깅 설정
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=3

# 모니터링 설정
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=false

# 백업 설정 (개발용은 비활성화)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# 알림 설정
ALERT_EMAIL=dev@example.com
SLACK_WEBHOOK_URL=

# 성능 설정 (개발용)
WORKER_PROCESSES=2
WORKER_CONNECTIONS=512
MAX_REQUESTS=500
MAX_REQUESTS_JITTER=50

# 파일 업로드 설정
MAX_FILE_SIZE=10MB
UPLOAD_PATH=uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# 도메인 설정 (개발용)
DOMAIN=localhost:5000
ADMIN_DOMAIN=localhost:5000

# 캐시 설정 (개발용은 Simple Cache)
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# 세션 설정 (개발용)
SESSION_TYPE=filesystem
SESSION_KEY_PREFIX=your_program_dev_session

# 메일 설정 (개발용)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=dev@example.com
MAIL_PASSWORD=dev_password
MAIL_DEFAULT_SENDER=dev@example.com

# 외부 API 설정 (개발용)
KAKAO_API_KEY=dev_kakao_api_key
GOOGLE_MAPS_API_KEY=dev_google_maps_api_key

# 데이터베이스 연결 풀 설정 (개발용)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis 연결 풀 설정 (개발용)
REDIS_POOL_SIZE=5
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# 웹소켓 설정
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001
WEBSOCKET_MAX_CONNECTIONS=100

# 실시간 알림 설정
REALTIME_NOTIFICATIONS_ENABLED=true
NOTIFICATION_QUEUE_SIZE=100
NOTIFICATION_WORKER_COUNT=2

# API 문서 설정 (개발용은 활성화)
API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true
REDOC_ENABLED=true

# 디버그 설정 (개발용)
DEBUG_TOOLBAR_ENABLED=true
PROFILER_ENABLED=true
SQL_LOGGING_ENABLED=true

# 테스트 설정
TESTING_ENABLED=true
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/your_program_test

# 개발 도구 설정
FLASK_DEBUG_TOOLBAR_ENABLED=true
FLASK_PROFILER_ENABLED=true
SQLALCHEMY_ECHO=true

# 비즈니스 설정 (개발용)
BRAND_CREATION_ENABLED=true
MODULE_INSTALLATION_ENABLED=true
PLUGIN_MARKETPLACE_ENABLED=true
DEVELOPMENT_MODE_ENABLED=true

# 사용자 제한 (개발용은 관대하게)
MAX_USERS_PER_BRAND=10000
MAX_BRANDS_PER_ADMIN=1000
MAX_MODULES_PER_BRAND=100