# 가상 서버용 환경변수 설정

# 애플리케이션 설정
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=virtual-server-secret-key
JWT_SECRET_KEY=virtual-server-jwt-secret-key

# 데이터베이스 설정 (SQLite)
DATABASE_URL=sqlite:///instance/your_program_virtual.db

# Redis 설정 (가상 서버에서는 비활성화)
REDIS_URL=
REDIS_PASSWORD=

# 보안 설정 (가상 서버용 - 모든 origin 허용)
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=logs/virtual_server.log

# 캐시 설정 (Redis 없이 메모리 캐시만 사용)
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# 네트워크 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
FRONTEND_PORT=3000

# 웹소켓 설정
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001

# 가상 서버 전용 설정
VIRTUAL_SERVER_MODE=true
DISABLE_REDIS=true
DISABLE_EXTERNAL_SERVICES=true

# OAuth 설정 (가상 서버에서는 비활성화)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 2FA 설정 (가상 서버에서는 비활성화)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
SMS_API_KEY=
SMS_SECRET_KEY=