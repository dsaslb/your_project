# Your Program 프로덕션 환경 변수 템플릿
# 이 파일을 복사하여 production.env로 만들고 실제 값으로 수정하세요

# ==============================================
# 🔐 보안 설정 (필수)
# ==============================================
SECRET_KEY=your-super-strong-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# ==============================================
# 🗄️ 데이터베이스 설정
# ==============================================
DATABASE_URL=postgresql://your_user:your_password@postgres:5432/your_program_prod
POSTGRES_DB=your_program_prod
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_secure_db_password

# ==============================================
# 🚀 Redis 캐시 설정
# ==============================================
REDIS_URL=redis://:your_redis_password@redis:6379/0
REDIS_PASSWORD=your_secure_redis_password

# ==============================================
# 🌐 애플리케이션 설정
# ==============================================
FLASK_ENV=production
FLASK_DEBUG=false
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_APP_NAME=Your Program

# ==============================================
# 📧 이메일 설정 (SMTP)
# ==============================================
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@your-domain.com
SMTP_PASSWORD=your_email_password
SMTP_USE_TLS=true

# ==============================================
# 🔒 SSL/도메인 설정
# ==============================================
DOMAIN_NAME=your-domain.com
SSL_EMAIL=admin@your-domain.com

# ==============================================
# 📊 모니터링 설정
# ==============================================
GRAFANA_PASSWORD=your_secure_grafana_password

# ==============================================
# 🔑 OAuth2 설정
# ==============================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/oauth/google/callback

KAKAO_CLIENT_ID=your_kakao_oauth_client_id
KAKAO_CLIENT_SECRET=your_kakao_oauth_client_secret
KAKAO_REDIRECT_URI=https://your-domain.com/api/auth/oauth/kakao/callback

# ==============================================
# 💳 결제 시스템 설정 (선택사항)
# ==============================================
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ==============================================
# ☁️ 클라우드 스토리지 설정 (선택사항)
# ==============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-northeast-2

# ==============================================
# 📱 푸시 알림 설정 (선택사항)
# ==============================================
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id

# ==============================================
# 🤖 AI/ML 설정 (선택사항)
# ==============================================
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ==============================================
# 📈 분석/추적 설정 (선택사항)
# ==============================================
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id