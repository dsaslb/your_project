# Your Program 프로덕션 환경 설정

# 애플리케이션 설정
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-super-secret-production-key-change-this-immediately
JWT_SECRET_KEY=your-super-secret-jwt-production-key-change-this-immediately

# 데이터베이스 설정
DATABASE_URL=postgresql://your_program:password@db:5432/your_program
DB_HOST=db
DB_PORT=5432
DB_NAME=your_program
DB_USER=your_program
DB_PASSWORD=password

# Redis 설정
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=redispassword

# OAuth2 설정
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourprogram.com/api/auth/oauth/google/callback

KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=https://yourprogram.com/api/auth/oauth/kakao/callback

# 2FA 설정
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_USE_TLS=true

SMS_API_KEY=your_sms_api_key
SMS_SECRET_KEY=your_sms_secret_key
SMS_FROM_NUMBER=your_sms_number

# 보안 설정
CORS_ORIGINS=https://yourprogram.com,https://admin.yourprogram.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per day;20 per hour;5 per minute
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# 로깅 설정
LOG_LEVEL=ERROR
LOG_FILE=logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# 모니터링 설정
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# 백업 설정
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# 알림 설정
ALERT_EMAIL=admin@yourprogram.com
SLACK_WEBHOOK_URL=your_slack_webhook_url

# 성능 설정
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1024
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# 파일 업로드 설정
MAX_FILE_SIZE=10MB
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# SSL 설정
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_PROTOCOLS=TLSv1.2,TLSv1.3

# 도메인 설정
DOMAIN=yourprogram.com
ADMIN_DOMAIN=admin.yourprogram.com

# 캐시 설정
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://redis:6379/1
CACHE_DEFAULT_TIMEOUT=300

# 세션 설정
SESSION_TYPE=redis
SESSION_REDIS=redis://redis:6379/2
SESSION_KEY_PREFIX=your_program_session

# 메일 설정
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@yourprogram.com

# 외부 API 설정
KAKAO_API_KEY=your_kakao_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 모니터링 API 키
PROMETHEUS_API_KEY=your_prometheus_api_key
GRAFANA_API_KEY=your_grafana_api_key

# 백업 스토리지 설정
BACKUP_STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-backup-bucket
AWS_REGION=ap-northeast-2

# 로그 수집 설정
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_URL=http://logstash:5044
KIBANA_URL=http://kibana:5601

# 성능 모니터링
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=Your Program Production

# 보안 모니터링
SECURITY_SCAN_ENABLED=true
VULNERABILITY_SCAN_SCHEDULE=0 3 * * *
PENETRATION_TEST_ENABLED=false

# 비즈니스 설정
BRAND_CREATION_ENABLED=true
MODULE_INSTALLATION_ENABLED=true
PLUGIN_MARKETPLACE_ENABLED=true
DEVELOPMENT_MODE_ENABLED=false

# 사용자 제한
MAX_USERS_PER_BRAND=1000
MAX_BRANDS_PER_ADMIN=100
MAX_MODULES_PER_BRAND=50

# 결제 설정 (필요시)
PAYMENT_GATEWAY=stripe
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# 분석 설정
GOOGLE_ANALYTICS_ID=your_google_analytics_id
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# CDN 설정
CDN_ENABLED=true
CDN_URL=https://cdn.yourprogram.com
CDN_API_KEY=your_cdn_api_key

# 캐시 무효화 설정
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_PATTERN=*/*

# 데이터베이스 연결 풀 설정
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis 연결 풀 설정
REDIS_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# 웹소켓 설정
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=5001
WEBSOCKET_MAX_CONNECTIONS=1000

# 실시간 알림 설정
REALTIME_NOTIFICATIONS_ENABLED=true
NOTIFICATION_QUEUE_SIZE=1000
NOTIFICATION_WORKER_COUNT=5

# API 문서 설정
API_DOCS_ENABLED=false
SWAGGER_UI_ENABLED=false
REDOC_ENABLED=false

# 디버그 설정
DEBUG_TOOLBAR_ENABLED=false
PROFILER_ENABLED=false
SQL_LOGGING_ENABLED=false

# 테스트 설정
TESTING_ENABLED=false
TEST_DATABASE_URL=postgresql://test_user:test_password@test_db:5432/test_db

# 개발 도구 설정
FLASK_DEBUG_TOOLBAR_ENABLED=false
FLASK_PROFILER_ENABLED=false
SQLALCHEMY_ECHO=false 