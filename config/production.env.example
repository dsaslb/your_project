# 프로덕션 환경 변수 예시
# 실제 운영 환경에서는 이 파일을 .env.production로 복사하고 값을 수정하세요

# 애플리케이션 설정
FLASK_ENV=production
SECRET_KEY=your-super-secret-production-key-change-this-immediately
DEBUG=False

# 데이터베이스 설정
DATABASE_URL=postgresql://your_user:your_secure_password@localhost:5432/your_program_prod
DB_PASSWORD=your_secure_password

# Redis 설정
REDIS_URL=redis://localhost:6379/0

# 이메일 설정
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# 도메인 설정
DOMAIN=your-domain.com
ADMIN_DOMAIN=admin.your-domain.com

# SSL 인증서 경로
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 모니터링 설정
GRAFANA_PASSWORD=your-grafana-password
PROMETHEUS_ENABLED=True

# AI 모델 설정
AI_MODELS_ENABLED=True
AI_CACHE_SIZE=1000

# 성능 최적화 설정
CACHE_ENABLED=True
QUERY_OPTIMIZATION_ENABLED=True
ASYNC_PROCESSING_ENABLED=True

# 보안 설정
RATE_LIMIT_ENABLED=True
CORS_ENABLED=True
CSRF_ENABLED=True

# 백업 설정
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=logs/production.log

# 플러그인 설정
PLUGIN_AUTO_LOAD=True
PLUGIN_SANDBOX_ENABLED=True

# 알림 설정
NOTIFICATION_ENABLED=True
SLACK_WEBHOOK_URL=your-slack-webhook-url
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 분석 설정
ANALYTICS_ENABLED=True
ANALYTICS_RETENTION_DAYS=90

# API 설정
API_RATE_LIMIT=1000
API_VERSION=v1

# 웹소켓 설정
SOCKETIO_ENABLED=True
SOCKETIO_PING_TIMEOUT=60
SOCKETIO_PING_INTERVAL=25 